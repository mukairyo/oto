{
  "manifest_version": 2,
  "name": "Oto Shield",
  "version": "1.266.23.9807",
  "description": "Oto's own blocker: stops known ad, tracker and telemetry addresses and ad scripts, and hides common ad boxes.",
  "browser_specific_settings": {
    "gecko": {
      "id": "shield@oto.app"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "rules.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "hide.css"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
