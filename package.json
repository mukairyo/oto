{
  "name": "oto",
  "productName": "Oto",
  "version": "1.9.900",
  "description": "Oto — a calm, minimal browser for Windows.",
  "homepage": "https://github.com/mukairyo/oto",
  "main": "main.js",
  "author": "Ryo",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/build-preload.js && electron .",
    "dist": "node scripts/build-preload.js && electron-builder --win",
    "pack": "node scripts/build-preload.js && electron-builder --win dir",
    "test": "node --test --test-force-exit \"test/*.test.js\"",
    "test:e2e": "node scripts/build-preload.js --check && node test/e2e/run.js",
    "lint": "node scripts/lint.js"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "adm-zip": "^0.6.1",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0",
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "adm-zip": "^0.6.1"
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v45.2.1+wvcus",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.ryo.oto",
    "productName": "Oto",
    "copyright": "Oto",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "account.js",
      "preload.js",
      "preload.bundle.js",
      "page-preload.js",
      "blocklist.js",
      "trackers.js",
      "main/**/*",
      "src/**/*",
      "vendor-ubol/**/*",
      "vendor-ghostery/**/*",
      "build/icon.png",
      "package.json",
      "CHANGELOG.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "vendor-tor",
          "to": "tor",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Oto",
      "artifactName": "Oto-Setup-${env.OTO_VERSION}.exe",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "menuCategory": false,
      "uninstallDisplayName": "Oto"
    },
    "portable": {
      "artifactName": "Oto-Portable-${version}.exe"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "oto",
      "artifactName": "Oto-${env.OTO_VERSION}.${ext}",
      "category": "Network;WebBrowser",
      "synopsis": "A calm, private browser built around your spaces",
      "description": "Oto is a web browser with Spaces, a built-in blocker (Shield), Oto VPN over Tor and themes.",
      "maintainer": "Ryo (mukairyo) <noreply@github.com>",
      "vendor": "Oto",
      "mimeTypes": [
        "text/html",
        "text/xml",
        "application/xhtml+xml",
        "x-scheme-handler/http",
        "x-scheme-handler/https"
      ],
      "desktop": {
        "entry": {
          "Name": "Oto",
          "GenericName": "Web Browser",
          "Comment": "Browse the web with Oto",
          "Categories": "Network;WebBrowser;",
          "StartupWMClass": "Oto",
          "Keywords": "browser;web;internet;"
        }
      }
    },
    "pacman": {
      "packageName": "oto-browser",
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libxss",
        "libnotify",
        "libxtst",
        "xdg-utils",
        "libsecret"
      ],
      "fpm": [
        "--pacman-optional-depends",
        "tor: Oto VPN",
        "--pacman-optional-depends",
        "gnome-keyring: keep saved passwords locked (or KWallet)"
      ]
    },
    "appImage": {
      "artifactName": "Oto-${env.OTO_VERSION}.AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mukairyo",
        "repo": "oto",
        "releaseType": "release"
      }
    ],
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "afterSign": "build/vmp-sign.js"
  },
  "otoVersion": "1.9.9"
}
