{
  "name": "oto",
  "productName": "Oto",
  "version": "1.0.0-owner.7",
  "description": "Oto \u2014 a calm, minimal browser for Windows.",
  "main": "main.js",
  "author": "Ryo",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win dir"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "adm-zip": "^0.6.1",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0",
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.ryo.oto",
    "productName": "Oto",
    "copyright": "Oto",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "blocklist.js",
      "src/**/*",
      "build/icon.png",
      "package.json",
      "CHANGELOG.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Oto",
      "artifactName": "Oto-Setup-${env.OTO_VERSION}.exe",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "menuCategory": false,
      "uninstallDisplayName": "Oto"
    },
    "portable": {
      "artifactName": "Oto-Portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mukairyo",
        "repo": "oto",
        "releaseType": "release"
      }
    ]
  },
  "otoVersion": "1.0.0-owner.7"
}
